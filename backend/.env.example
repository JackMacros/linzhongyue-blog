# MySQL
BLOG_DB_URL=jdbc:mysql://127.0.0.1:3306/linzhongyue_blog?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
BLOG_DB_USERNAME=blog_app
BLOG_DB_PASSWORD=

# Redis (Sa-Token sessions and content cache)
BLOG_REDIS_HOST=127.0.0.1
BLOG_REDIS_PORT=6379
BLOG_REDIS_PASSWORD=
BLOG_REDIS_DATABASE=1

# Bootstrap the only administrator when admin_user is empty
BLOG_ADMIN_USERNAME=admin
BLOG_ADMIN_PASSWORD=
BLOG_ADMIN_NICKNAME=Blog Admin
BLOG_ADMIN_EMAIL=admin@example.com

# Local development defaults; override both values in production
BLOG_AUTH_COOKIE_SECURE=false
BLOG_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Qiniu image storage (required only when uploads are enabled)
BLOG_QINIU_ACCESS_KEY=
BLOG_QINIU_SECRET_KEY=
BLOG_QINIU_BUCKET=
BLOG_QINIU_DOMAIN=https://cdn.example.com
BLOG_QINIU_ZONE=auto

# Legacy migration: enable temporarily, then remove all legacy credentials
BLOG_LEGACY_MIGRATION_ENABLED=false
BLOG_LEGACY_DB_URL=
BLOG_LEGACY_DB_USERNAME=
BLOG_LEGACY_DB_PASSWORD=
BLOG_LEGACY_REPORT_DIR=migration-reports
